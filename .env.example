# Copie para .env e ajuste. Nunca coloque credenciais reais neste arquivo.

# Conexão PostgreSQL. O padrão corresponde ao servidor local iniciado por `npm run db`.
DATABASE_URL="postgresql://zakfinance:zakfinance@localhost:5434/zakfinance"

# Banco dos testes de integração e e2e (apagado a cada execução — nunca aponte para dados reais).
TEST_DATABASE_URL="postgresql://zakfinance:zakfinance@localhost:5434/zakfinance_test"

# Duração da sessão, em horas.
SESSION_TTL_HOURS="12"

# Fuso usado para "hoje".
APP_TIMEZONE="America/Sao_Paulo"

# Tamanho máximo do arquivo importado, em MB.
MAX_UPLOAD_MB="10"

# Usuário criado por `npm run db:seed` quando ainda não há nenhum.
# Sem ADMIN_PASSWORD, uma senha aleatória é gerada e mostrada uma vez.
# A senha deve ser trocada no primeiro acesso.
ADMIN_EMAIL="zak@exemplo.com"
# ADMIN_PASSWORD=""
# ADMIN_NAME="Zak"

# Opcional: pasta de dados do PostgreSQL embutido.
# EMBEDDED_PG_DIR=".data/postgres"
